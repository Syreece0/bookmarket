# Copy to .env and fill in real values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (recommended). If unset, local development falls back to SQLite.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/bookmarket

# Paystack (get keys from your Paystack dashboard; use test keys while developing)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# Private storage for paid book files in production (S3-compatible)
USE_S3=False
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_STORAGE_BUCKET_NAME=placeholder-private-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Email (console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
